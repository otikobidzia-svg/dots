# hyprland.conf:279  bind = $mainMod, Q, killactive,
bindsym $mod+q kill
# hyprland.conf:280  bind = $mainMod, P, exec, ... hyprctl dispatch exit
bindsym $mod+p exec "i3-msg exit"
# hyprland.conf:281  bind = $mainMod, E, exec, $fileManager
bindsym $mod+e exec $fileManager
# hyprland.conf:282  bind = $mainMod, Z, togglefloating,
bindsym $mod+z floating toggle
# hyprland.conf:283  bind = $mainMod, Space, exec, $menu
bindsym $mod+space exec $menu
# hyprland.conf:284  bind = $mainMod, P, pseudo,          <- no i3 equivalent
# hyprland.conf:285  bind = $mainMod, J, layoutmsg, togglesplit  (set above)
# hyprland.conf:286  bind = $mainMod, B, exec, /usr/bin/firefox
bindsym $mod+b exec /usr/bin/firefox
# hyprland.conf:287  bind = $mainMod, W, exec, /home/otiko/.local/bin/waypaper
# [rice] waypaper is Wayland-only; setwall paints the X11 root window instead.
# No argument = random image from ~/pictures, or pass a file to set one.
bindsym $mod+w exec /home/otiko/.local/bin/setwall
bindsym $mod+Shift+w exec /home/otiko/.local/bin/setwall --list

# [rice] screenshot. grim/slurp/wl-copy from the hyprland config are Wayland
# only; xshot grabs the X11 root window with libX11 + GdkPixbuf.
bindsym $mod+Print exec /home/otiko/.local/bin/xshot
bindsym Print exec /home/otiko/.local/bin/xshot

# [rice] restart the status bar after editing ~/.local/bin/gtkbar or bardata.py.
# gtkbar takes over the lock in ~/.cache/gtkbar.lock and evicts the instance that
# holds it, so running it again is all it takes to restart it.
bindsym $mod+Shift+p exec --no-startup-id /home/otiko/.local/bin/gtkbar >>/home/otiko/.cache/gtkbar.log 2>&1


# hyprland.conf:290-293  move focus with arrows  (set above)

# hyprland.conf:320  bind = $mainMod, S, togglespecialworkspace, magic
# (unnamed scratchpad on purpose: a pre-declared "scratchpad magic" would leave
#  an empty container on the workspace)
bindsym $mod+s scratchpad show
# hyprland.conf:321  bind = $mainMod SHIFT, S, movetoworkspace, special:magic
bindsym $mod+Shift+s move scratchpad

# hyprland.conf:324-325  scroll through workspaces
bindsym $mod+button5 workspace next
bindsym $mod+button4 workspace prev

# hyprland.conf:328-329  bindm = $mainMod, mouse:272, movewindow / 273 resizewindow
# (i3 equivalent is handled by floating_modifier + tiling_drag near the top)

# hyprland.conf:340-343  media keys (playerctl)
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# hyprland.conf:336-337  brightness (needs brightnessctl, not installed here)
#bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl -e4 -n2 set 5%+
#bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -e4 -n2 set 5%+

