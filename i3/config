# [session startup] -----------------------------------------------------------------------
# This session is "login -> zsh -> startx -> xinit ~/.xinitrc -> exec i3": there is no
# session manager, so nothing ever reads ~/.config/autostart/*.desktop here and those
# files are inert. Anything that has to start with the session belongs here instead.
# All three helpers are idempotent, so it does not matter whether a reload re-runs them.

# Compositor. i3 does not composite, so without this kitty's background_opacity
# is ignored and everything is opaque. Alpine v3.24's picom (13) segfaults on this
# machine, so this runs the 12.5-r1 build in ~/.local — see ~/.local/bin/picom.
# Config: ~/.config/picom/picom.conf (Hyprland's blur/rounding/shadow, mapped).
exec --no-startup-id /home/otiko/.local/bin/picom

# Wallpaper. --restore leaves an already installed wallpaper alone, so this never
# reshuffles it; setwall keeps a holder process alive for the root pixmap it draws.
exec --no-startup-id /home/otiko/.local/bin/setwall --restore

# Status bar: the custom GTK3 one (see the note above on why not i3bar/polybar).
exec --no-startup-id /home/otiko/.local/bin/gtkbar >>/home/otiko/.cache/gtkbar.log 2>&1

# Audio. This replaces ~/.config/autostart/pipewire.desktop, which never ran; the
# pgrep guards keep a reload from starting a second pipewire/wireplumber.
exec --no-startup-id sh -c 'pgrep -x pipewire >/dev/null || pipewire'
exec --no-startup-id sh -c 'pgrep -x wireplumber >/dev/null || wireplumber'

